{
    "name": "roo_pb",
    "version": "1.0.0",
    "description": "Lightweight C++17 protocol buffers for byte buffers with roo_io utilities with independent Python generation",
    "license": "MIT",
    "keywords": [
        "protobuf",
        "serialization",
        "embedded"
    ],
    "frameworks": [
        "arduino",
        "espidf"
    ],
    "platforms": "*",
    "build": {
        "flags": [
            "-std=gnu++17"
        ]
    },
    "dependencies": {
        "dejwk/roo_backport": ">=1.3.0",
        "dejwk/roo_logging": ">=1.6.1",
        "dejwk/roo_io": ">=2.5.0"
    }
}